{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Topic Definitions API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Topic Definitions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get topic definitions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/webhooks/topic-definitions",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "search",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query"
              },
              {
                "name": "topic",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get all available webhook subscription topic definitions and their filterable conditions"
        }
      ]
    }
  ],
  "bundled": true
}