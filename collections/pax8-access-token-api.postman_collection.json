                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"client_id\": \"<client-id>\",\n  \"client_secret\": \"<client-secret>\",\n  \"audience\": \"https://api.pax8.com\",\n  \"grant_type\": \"client_credentials\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"<access-token>\",\n  \"expires_in\": 86400,\n  \"token_type\": \"Bearer\"\n}",
