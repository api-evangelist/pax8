      "name": "Access Token",
      "description": {
        "content": "The Access Token that allows access to the Pax8 API",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a970d124-b147-406f-bd6e-d35b2182cbaa",
          "name": "Create a new Access Token",
          "request": {
            "name": "Create a new Access Token",
            "description": {
              "content": "Create a new Access Token. Use the code examples to create an Access token on your local machine. Then copy the `access_token` into the Authorization header of any endpoint in the documentation to start making calls. The audience should be set to `https://api.pax8.com` for the partner endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"<string>\",\n  \"client_secret\": \"<string>\",\n  \"audience\": \"<string>\",\n  \"grant_type\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "3fa95991-95b2-409b-a7c5-9ce0a309fd87",
              "name": "successful operation",
              "originalRequest": {
                "url": {
                  "path": [
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
