{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Preference attachments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Preference attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Upload preference attachments",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/v2/quote-preferences/attachments",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Upload preference attachments based on library attachments."
        },
        {
          "info": {
            "name": "Delete preference attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pax8.com/v1/v2/quote-preferences/attachments/:attachmentId",
            "params": [
              {
                "name": "attachmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes single attachment from the preferences."
        }
      ]
    }
  ],
  "bundled": true
}