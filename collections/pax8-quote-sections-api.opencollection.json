{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Quote sections API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote sections",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get quote sections",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/sections",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns a list of sections associated to the specified quoteId."
        },
        {
          "info": {
            "name": "Create Section",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/sections",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new section within a specified quote to organize line items."
        },
        {
          "info": {
            "name": "Update Sections",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/sections",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update sections within a specified quote."
        }
      ]
    }
  ],
  "bundled": true
}