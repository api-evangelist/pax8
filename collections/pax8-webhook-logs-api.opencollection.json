{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Webhook Logs API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhook Logs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query webhook logs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/webhooks/:webhookId/logs",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              },
              {
                "name": "topicName",
                "value": "",
                "type": "query",
                "description": "Query params used to filter results"
              },
              {
                "name": "page",
                "value": "",
                "type": "query"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter value for the last delivery status of the webhook"
              },
              {
                "name": "startDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Sort field and order, format: field:asc/desc"
              },
              {
                "name": "query",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Lists instances of WebhookLogView with the ability to query against fields in WebhookLogView."
        },
        {
          "info": {
            "name": "Get webhook log by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/webhooks/:webhookId/logs/:id",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              },
              {
                "name": "id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Reads an instance of WebhookLogView."
        },
        {
          "info": {
            "name": "Retry webhook delivery",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/webhooks/:webhookId/logs/:logId/retry",
            "params": [
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              },
              {
                "name": "logId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retry sending a webhook that previously failed"
        }
      ]
    }
  ],
  "bundled": true
}