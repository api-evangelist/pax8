{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Access Token",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create a new Access Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new Access Token. Use the code examples to create an Access token on your local machine. Then copy the `access_token` into the Authorization header of any endpoint in the documentation to start making calls. The audience should be set to `https://api.pax8.com` for the partner endpoints."
        }
      ]
    }
  ],
  "bundled": true
}