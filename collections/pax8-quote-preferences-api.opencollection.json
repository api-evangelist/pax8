{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Quote preferences API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote preferences",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get quote preferences",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/v2/quote-preferences"
          },
          "docs": "Returns quote preferences associated to the current user's partner account."
        },
        {
          "info": {
            "name": "Update quote preferences",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.pax8.com/v1/v2/quote-preferences",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create or update preferences for quotes."
        }
      ]
    }
  ],
  "bundled": true
}