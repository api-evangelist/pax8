{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Quote access list API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote access list",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get quote access list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/access-list",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns the access list entries associated to the specified quoteId."
        },
        {
          "info": {
            "name": "Add access list entries",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/access-list",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Share the quote by adding the emails of the intended recipients to this access list."
        },
        {
          "info": {
            "name": "Delete quote access list entry",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/access-list/:accessListEntryId",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              },
              {
                "name": "accessListEntryId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a specific access list entry from a quote."
        }
      ]
    }
  ],
  "bundled": true
}