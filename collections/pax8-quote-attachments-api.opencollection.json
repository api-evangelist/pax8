{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Quote attachments API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Quote attachments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Download all quote attachments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/attachments",
            "params": [
              {
                "name": "downloadZip",
                "value": "",
                "type": "query",
                "description": "Must be set to true to download the ZIP."
              },
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Downloads all quote attachments as a single zip file"
        },
        {
          "info": {
            "name": "Upload attachments to quote",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/attachments",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "attachments",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads attachments to the specified quote."
        },
        {
          "info": {
            "name": "Update attachments",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/attachments",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update attachments within a specified quote."
        },
        {
          "info": {
            "name": "Copy attachment to quote from library",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/attachments/shared",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adds a copy of an existing library document as an attachment to the specified quote."
        },
        {
          "info": {
            "name": "Download attachment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/attachments/:attachmentId",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "download",
                "value": "",
                "type": "query",
                "description": "Must be set to true to download the file."
              }
            ]
          },
          "docs": "Downloads single attachment from a specified quote."
        },
        {
          "info": {
            "name": "Delete attachment",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.pax8.com/v1/v2/quotes/:quoteId/attachments/:attachmentId",
            "params": [
              {
                "name": "quoteId",
                "value": "",
                "type": "path"
              },
              {
                "name": "attachmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an attachment from a specified quote."
        }
      ]
    }
  ],
  "bundled": true
}