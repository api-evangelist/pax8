{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Provision Requests API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Provision Requests",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Provision Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provision-requests"
          },
          "docs": "Get All Provision Requests"
        },
        {
          "info": {
            "name": "Get One Provision Request",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provision-requests/:provisionRequestId",
            "params": [
              {
                "name": "provisionRequestId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get One Provision Request"
        },
        {
          "info": {
            "name": "Get All Unfulfilled Provision Requests",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provision-requests/unfulfilled"
          },
          "docs": "Get All Unfulfilled Provision Requests"
        }
      ]
    }
  ],
  "bundled": true
}