{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Orders API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Orders",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/orders",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number to request for in the orders list"
              },
              {
                "name": "size",
                "value": "",
                "type": "query"
              },
              {
                "name": "companyId",
                "value": "",
                "type": "query",
                "description": "The company id to filter on"
              }
            ]
          },
          "docs": "Returns a paginated list of orders. Currently NOT supported for scheduled orders(orders with a future date)."
        },
        {
          "info": {
            "name": "Create Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/orders",
            "params": [
              {
                "name": "isMock",
                "value": "",
                "type": "query",
                "description": "Perform validations only. Skip any interactions with the database."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a new order. Currently NOT supported for scheduled orders(orders with a future date)."
        },
        {
          "info": {
            "name": "Get Order By ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/orders/:orderId",
            "params": [
              {
                "name": "orderId",
                "value": "",
                "type": "path",
                "description": "The unique identifier for an order record"
              }
            ]
          },
          "docs": "Returns the Order record specified by OrderId. Currently NOT supported for scheduled orders"
        }
      ]
    }
  ],
  "bundled": true
}