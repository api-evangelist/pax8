{
  "opencollection": "1.0.0",
  "info": {
    "name": "Authentication Access Token Provisioners API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://token-manager.pax8.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Provisioners",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get All Webhook Configurations for a Provisioner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provisioners/:provisionerId/webhooks",
            "params": [
              {
                "name": "provisionerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get All Webhook Configurations for a Provisioner"
        },
        {
          "info": {
            "name": "Create a Webhook Configuration for a Provisioner",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.pax8.com/v1/provisioners/:provisionerId/webhooks",
            "params": [
              {
                "name": "provisionerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a Webhook Configuration for a Provisioner"
        },
        {
          "info": {
            "name": "Get All Provisioners",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provisioners"
          },
          "docs": "Get All Provisioners"
        },
        {
          "info": {
            "name": "Get One Provisioner by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provisioners/:provisionerId",
            "params": [
              {
                "name": "provisionerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get One Provisioner by ID"
        },
        {
          "info": {
            "name": "Get One Webhook for a Provisioner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provisioners/:provisionerId/webhooks/:webhookId",
            "params": [
              {
                "name": "provisionerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "webhookId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get One Webhook for a Provisioner"
        },
        {
          "info": {
            "name": "Get Latest Webhook for a Provisioner",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.pax8.com/v1/provisioners/:provisionerId/webhooks/latest",
            "params": [
              {
                "name": "provisionerId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Latest Webhook for a Provisioner"
        }
      ]
    }
  ],
  "bundled": true
}